# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=certificate_platform
DB_NAME_TEST=certificate_platform_test

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=24h

# CORS Configuration (Task 2 Vite frontend runs on port 5173 by default)
CORS_ORIGIN=http://localhost:5173

# Default Admin Credentials for database seed script
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=AdminPass@123
